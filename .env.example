# ==============================================================================
# YogaOS Environment Configuration Template
# All secrets and sensitive parameters must be configured here for local development.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_PORT=4000
WEB_PORT=3000

# PostgreSQL Configuration
DATABASE_URL=postgresql://yogaos:yogaos_secret@localhost:5432/yogaos_dev?schema=public
POSTGRES_USER=yogaos
POSTGRES_PASSWORD=yogaos_secret
POSTGRES_DB=yogaos_dev
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (Local dev placeholder - never use in production)
JWT_SECRET=super_secret_dev_jwt_key_32_characters_minimum_length_required!
JWT_EXPIRES_IN=7d

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
