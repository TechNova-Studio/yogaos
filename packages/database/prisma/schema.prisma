  primaryMedia  MediaAsset?    @relation("AsanaPrimaryMedia", fields: [primaryMediaId], references: [id], onDelete: SetNull)
  mediaList     AsanaMedia[]
  sequenceSteps SequenceStep[]

  @@index([tenantId, category, difficulty])
  @@index([tenantId, status])
  @@index([englishName, sanskritName])
