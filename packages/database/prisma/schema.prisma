  PROCESSING
  READY
  FAILED
  ARCHIVED
}

model Asana {
  id                String          @id @default(uuid())
  tenantId          String?
  sanskritName      String
  sanskritNameIast  String?
  englishName       String
  commonName        String?
  description       String?
  instructions      String?
  alignmentCues     String?
  category          AsanaCategory
  difficulty        AsanaDifficulty @default(BEGINNER)
  status            AsanaStatus     @default(PUBLISHED)
  isSharedReference Boolean         @default(false)
  anatomicalFocus   String[]        @default([])
  benefits          String[]        @default([])
  contraindications String[]        @default([])
  cautions          String?
  prepPoses         String[]        @default([])
  followUpPoses     String[]        @default([])
  variations        String[]        @default([])
  tags              String[]        @default([])
  primaryMediaId    String?
  createdByUserId   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  organization  Organization?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
