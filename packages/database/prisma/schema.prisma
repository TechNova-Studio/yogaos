model AsanaMedia {
  id           String   @id @default(uuid())
  tenantId     String?
  asanaId      String
  mediaAssetId String
  sortOrder    Int      @default(0)
  caption      String?
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())

  asana      Asana      @relation(fields: [asanaId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([asanaId, mediaAssetId])
  @@index([asanaId, sortOrder])
}

enum SequenceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum SequenceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExecutionMode {
  TIME_HOLD
  BREATH_COUNT
  REPETITION
}

enum StepSide {
  NONE
  RIGHT
  LEFT
}

model Sequence {
  id                         String         @id @default(uuid())
  tenantId                   String
  creatorUserId              String
  title                      String
  description                String?
  objective                  String?
  targetLevel                SequenceLevel  @default(ALL_LEVELS)
  intendedAudience           String?
  isStudioTemplate           Boolean        @default(false)
  tags                       String[]       @default([])
  status                     SequenceStatus @default(DRAFT)
  activeVersion              Int            @default(1)
  estimatedTotalDurationSecs Int            @default(0)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  deletedAt                  DateTime?

  organization Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creatorUser  User              @relation("SequencesCreatedByUser", fields: [creatorUserId], references: [id], onDelete: Restrict)
  versions     SequenceVersion[]

  @@index([tenantId, status])
  @@index([tenantId, title])
}

model SequenceVersion {
  id                         String         @id @default(uuid())
  tenantId                   String
  sequenceId                 String
  versionNumber              Int
  status                     SequenceStatus @default(DRAFT)
  totalEstimatedDurationSecs Int            @default(0)
  mediaManifest              Json?
  notes                      String?
  publishedAt                DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  organization     Organization           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequence         Sequence               @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  steps            SequenceStep[]
  attachedSessions ClassSessionInstance[]
  conductorSessions ConductorSession[]

  @@unique([tenantId, sequenceId, versionNumber])
  @@index([sequenceId, versionNumber])
  @@index([tenantId, status])
}

model SequenceStep {
  id                    String        @id @default(uuid())
  tenantId              String
  sequenceVersionId     String
  stepOrder             Int
  asanaId               String
  asanaNameSnapshot     String?
  sanskritNameSnapshot  String?
  executionMode         ExecutionMode @default(TIME_HOLD)
  durationSeconds       Int           @default(30)
  repetitionCount       Int?
  isBilateral           Boolean       @default(false)
  side                  StepSide      @default(NONE)
  restIntervalSeconds   Int           @default(0)
  voiceAudioMediaId     String?
  demoVideoMediaId      String?
  referenceImageMediaId String?
  teacherNotes          String?
  cues                  String?
  transitionNotes       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization        Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequenceVersion     SequenceVersion @relation(fields: [sequenceVersionId], references: [id], onDelete: Cascade)
  asana               Asana           @relation(fields: [asanaId], references: [id], onDelete: Restrict)
  voiceAudioMedia     MediaAsset?     @relation("StepVoiceAudio", fields: [voiceAudioMediaId], references: [id], onDelete: SetNull)
  demoVideoMedia      MediaAsset?     @relation("StepDemoVideo", fields: [demoVideoMediaId], references: [id], onDelete: SetNull)
  referenceImageMedia MediaAsset?     @relation("StepReferenceImage", fields: [referenceImageMediaId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sequenceVersionId, stepOrder])
  @@index([sequenceVersionId, stepOrder])
}

// ----------------------------------------------------------------------------
// P16 & P17: Automated Class Conductor Runtime Engine & Offline-First Playback
// ----------------------------------------------------------------------------

enum ConductorSessionStatus {
  READY
  OFFLINE_READY
  RUNNING
  PAUSED
  COMPLETED
  INTERRUPTED
  INTERRUPTED_ABANDONED
}

enum ConductorStepPhase {
  POSTURE_HOLD
  BILATERAL_SIDE_A
  BILATERAL_SIDE_B
  REST_INTERVAL
  TRANSITION
}

enum ConductorEventType {
  SESSION_INITIALIZED
  OFFLINE_PREPARATION_STARTED
  OFFLINE_READY
  OFFLINE_VERIFICATION_FAILED
  SESSION_STARTED
  STEP_STARTED
  STEP_COMPLETED
  STEP_SKIPPED
  STEP_PREVIOUS
  TIME_ADJUSTED
  SESSION_PAUSED
  SESSION_RESUMED
  SESSION_COMPLETED
  SESSION_INTERRUPTED
  SESSION_ABANDONED
  SESSION_RECOVERED
  OFFLINE_SYNC_COMPLETED
  MEDIA_PLAYBACK_STARTED
  MEDIA_PLAYBACK_ERROR
}

model ConductorSession {
  id                     String                 @id @default(uuid())
  tenantId               String
  sessionInstanceId      String                 @unique
  sequenceVersionId      String
  conductorInstructorId  String
  status                 ConductorSessionStatus @default(READY)
  currentStepIndex       Int                    @default(0)
  currentPhase           ConductorStepPhase     @default(POSTURE_HOLD)
  isOfflineReady         Boolean                @default(false)
  offlinePreparedAt      DateTime?
  preparationMetadata    Json?
  actualStartedAt        DateTime?
  actualConcludedAt      DateTime?
  totalElapsedSeconds    Int                    @default(0)
  completedStepsCount    Int                    @default(0)
  skippedStepsCount      Int                    @default(0)
  addedTimeSeconds       Int                    @default(0)
  clientSessionUuid      String
  lastHeartbeatAt        DateTime?
  lastSyncAt             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  organization        Organization            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionInstance     ClassSessionInstance    @relation(fields: [sessionInstanceId], references: [id], onDelete: Cascade)
  sequenceVersion     SequenceVersion         @relation(fields: [sequenceVersionId], references: [id], onDelete: Restrict)
  conductorInstructor User                    @relation("ConductorSessionsConducted", fields: [conductorInstructorId], references: [id], onDelete: Restrict)
  events              ConductorExecutionEvent[]

  @@index([tenantId, status])
  @@index([sessionInstanceId])
  @@index([sequenceVersionId])
}

model ConductorExecutionEvent {
  id                 String             @id @default(uuid())
  tenantId           String
  conductorSessionId String
  clientEventUuid    String             @unique
  eventType          ConductorEventType
  stepOrder          Int?
  clientTimestamp    DateTime
  serverReceivedAt   DateTime           @default(now())
  payload            Json?
  isOfflineSync      Boolean            @default(false)
  createdAt          DateTime           @default(now())

  organization     Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conductorSession ConductorSession @relation(fields: [conductorSessionId], references: [id], onDelete: Cascade)

  @@unique([conductorSessionId, clientEventUuid])
  @@index([conductorSessionId, clientTimestamp])
  @@index([tenantId, eventType])
}

