datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  MANAGER
  INSTRUCTOR
  RECEPTIONIST
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum StudentStatus {
  LEAD
  TRIAL
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL_BOOKED
  CONVERTED
  LOST
}

enum LeadSource {
  WALK_IN
  WEBSITE
  INSTAGRAM
  REFERRAL
  OTHER
}

enum ClassLevel {
  ALL_LEVELS
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BatchScheduleType {
  RECURRING_WEEKLY
  FIXED_WORKSHOP
}

enum BatchStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?
  fullName        String
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  credentials              UserCredential[]
  sessions                 Session[]
  resetTokens              PasswordResetToken[]
  memberships              OrganizationMember[]
  sentInvitations          Invitation[]              @relation("InvitedByUser")
  auditLogs                AuditLog[]
  healthDisclaimersUpdated StudentHealthDisclaimer[]
  studentActivities        StudentActivity[]
  instructorBatches        ClassBatch[]              @relation("InstructorBatches")
  instructorSessions       ClassSessionInstance[]    @relation("InstructorSessions")
  instructorProfiles       InstructorProfile[]
  attendanceMarked         AttendanceRecord[]        @relation("AttendanceMarkedByUser")
  creditLedgerActions      MembershipCreditLedger[]  @relation("CreditActionByUser")
  paymentsRecorded         PaymentTransaction[]      @relation("PaymentsRecordedByUser")
  refundsProcessed         RefundRecord[]            @relation("RefundsProcessedByUser")
  creditNotesIssued        CreditNote[]              @relation("CreditNotesIssuedByUser")
  uploadedMedia            MediaAsset[]              @relation("MediaUploadedByUser")
  createdAsanas            Asana[]                   @relation("AsanasCreatedByUser")
  createdSequences         Sequence[]                @relation("SequencesCreatedByUser")
  conductorSessionsConducted ConductorSession[]      @relation("ConductorSessionsConducted")

  @@index([email])
  @@index([phone])
}

model UserCredential {
  id         String   @id @default(uuid())
  userId     String
  type       String   @default("PASSWORD") // PASSWORD, OAUTH_GOOGLE, etc.
  secretHash String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  activeTenantId String?
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Organization {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  legalEntityName String?
  currency        String    @default("INR")
  timezone        String    @default("Asia/Kolkata")
  isGstRegistered Boolean   @default(false)
  gstin           String?
  panNumber       String?
  billingAddress  Json?
  settings        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  members                 OrganizationMember[]
  invitations             Invitation[]
  auditLogs               AuditLog[]
  branches                Branch[]
  rooms                   Room[]
  students                Student[]
  leads                   Lead[]
  classTypes              ClassType[]
  batches                 ClassBatch[]
  sessions                ClassSessionInstance[]
  instructorProfiles      InstructorProfile[]
  bookings                Booking[]
  waitlistEntries         WaitlistEntry[]
  attendanceRecords       AttendanceRecord[]
  membershipPlans         MembershipPlan[]
  studentMemberships      StudentMembership[]
  membershipCreditLedgers MembershipCreditLedger[]
  invoices                TaxInvoice[]
  payments                PaymentTransaction[]
  refunds                 RefundRecord[]
  creditNotes             CreditNote[]
  gatewayConfigs          PaymentGatewayConfig[]
  billingReminders        BillingReminder[]
  webhookEvents           WebhookEvent[]
  asanas                  Asana[]
  mediaAssets             MediaAsset[]
  sequences               Sequence[]
  sequenceVersions        SequenceVersion[]
  sequenceSteps           SequenceStep[]
  conductorSessions       ConductorSession[]
  conductorExecutionEvents ConductorExecutionEvent[]

  @@index([slug])
}

model OrganizationMember {
  id          String       @id @default(uuid())
  tenantId    String
  userId      String
  role        UserRole     @default(INSTRUCTOR)
  status      MemberStatus @default(ACTIVE)
  branchScope Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([userId])
}

model Invitation {
  id              String           @id @default(uuid())
  tenantId        String
  email           String
  role            UserRole         @default(INSTRUCTOR)
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())

  organization  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedByUser User         @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([email])
  @@index([tokenHash])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  details      Json?
  createdAt    DateTime @default(now())

  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([action])
}

model SystemHealthCheck {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now())
  status    String   @default("OK")
}

model Branch {
  id             String    @id @default(uuid())
  tenantId       String
  name           String
  slug           String
  streetAddress  String
  city           String
  state          String
  stateCode      String // Indian 2-digit GST state code, e.g. '29'
  postalCode     String
  phone          String
  email          String
  operatingHours Json?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization       Organization           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms              Room[]
  students           Student[]
  leads              Lead[]
  batches            ClassBatch[]
  sessions           ClassSessionInstance[]
  membershipPlans    MembershipPlan[]
  studentMemberships StudentMembership[]
  invoices           TaxInvoice[]
  payments           PaymentTransaction[]

  @@unique([tenantId, slug])
  @@index([tenantId, stateCode])
  @@index([tenantId, isActive])
}

model Room {
  id             String   @id @default(uuid())
  tenantId       String
  branchId       String
  name           String
  description    String?
  maxMatCapacity Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  batches      ClassBatch[]
  sessions     ClassSessionInstance[]

  @@index([tenantId, branchId])
  @@index([tenantId, isActive])
}

model Student {
  id                       String        @id @default(uuid())
  tenantId                 String
  homeBranchId             String
  fullName                 String
  mobilePhone              String
  email                    String?
  dateOfBirth              DateTime?
  gender                   String?
  emergencyContactName     String
  emergencyContactPhone    String
  emergencyContactRelation String
  status                   StudentStatus @default(ACTIVE)
  billingAddress           Json?
  billingStateCode         String?
  hasHealthAlert           Boolean       @default(false)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  deletedAt                DateTime?

  organization        Organization             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homeBranch          Branch                   @relation(fields: [homeBranchId], references: [id], onDelete: Restrict)
  healthDisclaimer    StudentHealthDisclaimer?
  consents            StudentConsent[]
  activities          StudentActivity[]
  convertedFromLead   Lead?                    @relation("ConvertedLeadStudent")
  bookings            Booking[]
  waitlistEntries     WaitlistEntry[]
  memberships         StudentMembership[]
  creditLedgerEntries MembershipCreditLedger[]
  invoices            TaxInvoice[]
  payments            PaymentTransaction[]
  refunds             RefundRecord[]
  billingReminders    BillingReminder[]

  @@index([tenantId, mobilePhone])
  @@index([tenantId, email])
  @@index([tenantId, fullName])
  @@index([tenantId, status])
  @@index([tenantId, homeBranchId])
}

model StudentHealthDisclaimer {
  id                    String   @id @default(uuid())
  tenantId              String
  studentId             String   @unique
  injurySummary         String? // Short non-clinical summary e.g. "Lower Back L4/L5, Right Wrist"
  healthNotesCiphertext String // AES-256-GCM encrypted detailed narrative
  healthNotesIv         String // 12-byte IV hex string
  healthNotesTag        String // 16-byte GCM authentication tag hex string
  hasPregnancyAlert     Boolean  @default(false)
  consentSigned         Boolean  @default(true)
  consentTimestamp      DateTime @default(now())
  consentIpAddress      String?
  updatedByUserId       String?
  updatedAt             DateTime @updatedAt

  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedByUser User?   @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId])
}

model StudentConsent {
  id          String   @id @default(uuid())
  tenantId    String
  studentId   String
  consentType String // LIABILITY_WAIVER, GENERAL_TERMS, PHOTO_VIDEO_RELEASE
  version     String   @default("1.0")
  isAgreed    Boolean  @default(true)
  agreedAt    DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
}

model StudentActivity {
  id                String   @id @default(uuid())
  tenantId          String
  studentId         String
  activityType      String // REGISTERED, PROFILE_UPDATED, HEALTH_DISCLAIMER_UPDATED, CONSENT_SIGNED, LEAD_CONVERTED, STAFF_NOTE
  title             String
  description       String?
  performedByUserId String?
  metadata          Json?
  createdAt         DateTime @default(now())

  student         Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  performedByUser User?   @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId, createdAt])
}

model Lead {
  id                 String     @id @default(uuid())
  tenantId           String
  branchId           String?
  fullName           String
  phone              String
  email              String?
  source             LeadSource @default(WALK_IN)
  interestedProgram  String?
  status             LeadStatus @default(NEW)
  followUpDate       DateTime?
  notes              String?
  convertedStudentId String?    @unique
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  convertedStudent Student?     @relation("ConvertedLeadStudent", fields: [convertedStudentId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@index([tenantId, followUpDate])
}

model ClassType {
  id                  String     @id @default(uuid())
  tenantId            String
  name                String
  description         String?
  category            String     @default("Hatha")
  level               ClassLevel @default(ALL_LEVELS)
  defaultDurationMins Int        @default(60)
  defaultCapacity     Int        @default(20)
  intensity           String?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  organization Organization           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches      ClassBatch[]
  sessions     ClassSessionInstance[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@index([tenantId, category])
}

model InstructorProfile {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  displayName    String
  bio            String?
  certifications String[] @default([])
  teachingStyles String[] @default([])
  hourlyRate     Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, userId])
}

model ClassBatch {
  id                  String            @id @default(uuid())
  tenantId            String
  classTypeId         String
  branchId            String
  roomId              String
  instructorId        String
  name                String
  description         String?
  scheduleType        BatchScheduleType @default(RECURRING_WEEKLY)
  status              BatchStatus       @default(DRAFT)
  startDate           DateTime
  endDate             DateTime?
  capacity            Int
  sessionDurationMins Int               @default(60)
  daysOfWeek          Int[]
  startTime           String
  endTime             String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  organization Organization           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classType    ClassType              @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  branch       Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  room         Room                   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  instructor   User                   @relation("InstructorBatches", fields: [instructorId], references: [id], onDelete: Restrict)
  sessions     ClassSessionInstance[]

  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([tenantId, roomId])
  @@index([tenantId, instructorId])
}

model ClassSessionInstance {
  id                        String        @id @default(uuid())
  tenantId                  String
  batchId                   String?
  classTypeId               String
  branchId                  String
  roomId                    String
  instructorId              String
  sessionDate               DateTime
  startTimestamp            DateTime
  endTimestamp              DateTime
  capacity                  Int
  status                    SessionStatus @default(SCHEDULED)
  attachedSequenceVersionId String?
  cancellationReason        String?
  notes                     String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  organization            Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch                   ClassBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  classType               ClassType        @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  branch                  Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  room                    Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  instructor              User             @relation("InstructorSessions", fields: [instructorId], references: [id], onDelete: Restrict)
  attachedSequenceVersion SequenceVersion? @relation(fields: [attachedSequenceVersionId], references: [id], onDelete: SetNull)
  bookings                Booking[]
  waitlistEntries         WaitlistEntry[]
  conductorSession        ConductorSession?

  @@index([tenantId, sessionDate])
  @@index([tenantId, startTimestamp])
  @@index([tenantId, status])
  @@index([roomId, startTimestamp, endTimestamp])
  @@index([instructorId, startTimestamp, endTimestamp])
  @@index([batchId])
}

// ----------------------------------------------------------------------------
// P10: Bookings, Waitlists & Attendance
// ----------------------------------------------------------------------------

enum BookingStatus {
  BOOKED
  ATTENDED
  LATE_CANCEL
  NO_SHOW
  CANCELLED
}

enum BookingSource {
  FRONT_DESK
  ONLINE
  ADMIN_OVERRIDE
}

enum WaitlistStatus {
  WAITING
  PROMOTED
  EXPIRED
  CANCELLED
}

enum CheckInMethod {
  FRONT_DESK_ROSTER
  KIOSK
  MANUAL_OVERRIDE
}

model Booking {
  id                   String        @id @default(uuid())
  tenantId             String
  sessionInstanceId    String
  studentId            String
  status               BookingStatus @default(BOOKED)
  source               BookingSource @default(FRONT_DESK)
  bookedAt             DateTime      @default(now())
  cancelledAt          DateTime?
  cancellationReason   String?
  notes                String?
  studentMembershipId  String?
  isPassCreditDeducted Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization         Organization             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session              ClassSessionInstance     @relation(fields: [sessionInstanceId], references: [id], onDelete: Cascade)
  student              Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentMembership    StudentMembership?       @relation(fields: [studentMembershipId], references: [id], onDelete: SetNull)
  attendance           AttendanceRecord?
  promotedFromWaitlist WaitlistEntry?           @relation("PromotedBooking")
  creditLedgerEntries  MembershipCreditLedger[]

  @@unique([tenantId, sessionInstanceId, studentId])
  @@index([tenantId, sessionInstanceId, status])
  @@index([tenantId, studentId])
  @@index([sessionInstanceId, status])
  @@index([studentMembershipId])
}

model WaitlistEntry {
  id                  String         @id @default(uuid())
  tenantId            String
  sessionInstanceId   String
  studentId           String
  priorityRank        Int
  status              WaitlistStatus @default(WAITING)
  promotedToBookingId String?        @unique
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization      Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session           ClassSessionInstance @relation(fields: [sessionInstanceId], references: [id], onDelete: Cascade)
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  promotedToBooking Booking?             @relation("PromotedBooking", fields: [promotedToBookingId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sessionInstanceId, priorityRank])
  @@unique([tenantId, sessionInstanceId, studentId])
  @@index([tenantId, sessionInstanceId, status, priorityRank])
  @@index([tenantId, studentId])
}

model AttendanceRecord {
  id                String        @id @default(uuid())
  tenantId          String
  bookingId         String        @unique
  checkedInAt       DateTime      @default(now())
  checkedInByUserId String
  checkInMethod     CheckInMethod @default(FRONT_DESK_ROSTER)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization    Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checkedInByUser User         @relation("AttendanceMarkedByUser", fields: [checkedInByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, checkedInAt])
  @@index([checkedInByUserId])
}

// ----------------------------------------------------------------------------
// P11: Membership Plans, Student Memberships & Class Passes
// ----------------------------------------------------------------------------

enum PlanType {
  TIME_UNLIMITED
  CLASS_PACK
  SINGLE_DROP_IN
}

enum MembershipStatus {
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

enum CreditLedgerEntryType {
  INITIAL_ALLOCATION
  REDEMPTION
  REFUND_RESTORE
  MANUAL_ADJUSTMENT
  EXPIRATION
}

model MembershipPlan {
  id                 String    @id @default(uuid())
  tenantId           String
  name               String
  description        String?
  planType           PlanType
  price              Decimal   @db.Decimal(10, 2)
  taxRatePercent     Decimal   @default(18.00) @db.Decimal(5, 2)
  sacCode            String    @default("9992")
  validityDays       Int
  creditCount        Int?
  maxFreezesAllowed  Int       @default(0)
  maxFreezeDays      Int       @default(0)
  isMultiBranchValid Boolean   @default(true)
  homeBranchId       String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  organization Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homeBranch   Branch?             @relation(fields: [homeBranchId], references: [id], onDelete: SetNull)
  memberships  StudentMembership[]

  @@index([tenantId, isActive])
  @@index([tenantId, planType])
}

model StudentMembership {
  id                      String                  @id @default(uuid())
  tenantId                String
  studentId               String
  membershipPlanId        String
  homeBranchId            String?
  planNameSnapshot        String
  planTypeSnapshot        PlanType
  priceSnapshot           Decimal                 @db.Decimal(10, 2)
  isMultiBranchSnapshot   Boolean                 @default(true)
  status                  MembershipStatus        @default(ACTIVE)
  startDate               DateTime
  expiryDate              DateTime
  totalCredits            Int?
  remainingCredits        Int?
  freezesUsed             Int                     @default(0)
  frozenAt                DateTime?
  freezeReason            String?
  totalFrozenDays         Int                     @default(0)
  notes                   String?
  renewedFromMembershipId String?
  renewalStatus           MembershipRenewalStatus @default(UPCOMING)
  autoRenewConsent        Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?

  organization Organization             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan         MembershipPlan           @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  homeBranch   Branch?                  @relation(fields: [homeBranchId], references: [id], onDelete: SetNull)
  renewedFrom  StudentMembership?       @relation("MembershipRenewals", fields: [renewedFromMembershipId], references: [id], onDelete: SetNull)
  renewals     StudentMembership[]      @relation("MembershipRenewals")
  bookings     Booking[]
  creditLedger MembershipCreditLedger[]
  invoices     TaxInvoice[]
  payments     PaymentTransaction[]
  reminders    BillingReminder[]

  @@index([tenantId, studentId, status])
  @@index([tenantId, expiryDate])
  @@index([membershipPlanId])
}

model MembershipCreditLedger {
  id                  String                @id @default(uuid())
  tenantId            String
  studentMembershipId String
  studentId           String
  bookingId           String?
  entryType           CreditLedgerEntryType
  creditsDelta        Int
  balanceAfter        Int
  reason              String?
  performedByUserId   String?
  createdAt           DateTime              @default(now())

  organization    Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership      StudentMembership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  booking         Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  performedByUser User?             @relation("CreditActionByUser", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentMembershipId, createdAt])
  @@index([tenantId, studentId])
  @@index([bookingId])
}

// ----------------------------------------------------------------------------
// P12: Billing, Payments, Invoices & GST
// ----------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  VOID
  CREDITED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  VOID
}

model TaxInvoice {
  id                  String        @id @default(uuid())
  tenantId            String
  branchId            String?
  studentId           String
  studentMembershipId String?
  invoiceNumber       String
  fiscalYear          String
  sequenceNumber      Int
  status              InvoiceStatus @default(ISSUED)
  issueDate           DateTime      @default(now())
  dueDate             DateTime?
  currency            String        @default("INR")
  subtotal            Decimal       @db.Decimal(10, 2)
  discountAmount      Decimal       @default(0.00) @db.Decimal(10, 2)
  taxableAmount       Decimal       @db.Decimal(10, 2)
  cgstAmount          Decimal       @default(0.00) @db.Decimal(10, 2)
  sgstAmount          Decimal       @default(0.00) @db.Decimal(10, 2)
  igstAmount          Decimal       @default(0.00) @db.Decimal(10, 2)
  totalTax            Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount         Decimal       @db.Decimal(10, 2)
  amountPaid          Decimal       @default(0.00) @db.Decimal(10, 2)
  balanceDue          Decimal       @db.Decimal(10, 2)
  supplierGstin       String?
  supplierLegalName   String
  supplierStateCode   String
  supplierAddress     Json?
  customerName        String
  customerPhone       String?
  customerEmail       String?
  customerGstin       String?
  customerStateCode   String
  customerAddress     Json?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization      Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentMembership StudentMembership?   @relation(fields: [studentMembershipId], references: [id], onDelete: SetNull)
  lineItems         InvoiceLineItem[]
  payments          PaymentTransaction[]
  creditNotes       CreditNote[]
  refunds           RefundRecord[]
  reminders         BillingReminder[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, studentId, status])
  @@index([tenantId, issueDate])
}

model InvoiceLineItem {
  id             String  @id @default(uuid())
  tenantId       String
  invoiceId      String
  description    String
  sacCode        String  @default("9992")
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0.00) @db.Decimal(10, 2)
  taxableAmount  Decimal @db.Decimal(10, 2)
  taxRatePercent Decimal @db.Decimal(5, 2)
  cgstAmount     Decimal @default(0.00) @db.Decimal(10, 2)
  sgstAmount     Decimal @default(0.00) @db.Decimal(10, 2)
  igstAmount     Decimal @default(0.00) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)
  metadata       Json?

  invoice TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PaymentTransaction {
  id                   String                  @id @default(uuid())
  tenantId             String
  branchId             String?
  invoiceId            String?
  studentId            String
  studentMembershipId  String?
  receiptNumber        String?
  amount               Decimal                 @db.Decimal(10, 2)
  currency             String                  @default("INR")
  paymentMode          PaymentMode
  utrReference         String?
  idempotencyKey       String?
  status               PaymentStatus           @default(COMPLETED)
  paidAt               DateTime                @default(now())
  recordedByUserId     String?
  notes                String?
  refundedAmount       Decimal                 @default(0.00) @db.Decimal(10, 2)
  gatewayProvider      PaymentGatewayProvider?
  gatewayOrderId       String?
  gatewayPaymentId     String?
  gatewaySignature     String?
  gatewayResponse      Json?
  reconciliationStatus ReconciliationStatus    @default(NOT_APPLICABLE)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization      Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoice           TaxInvoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  student           Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentMembership StudentMembership? @relation(fields: [studentMembershipId], references: [id], onDelete: SetNull)
  recordedByUser    User?              @relation("PaymentsRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  refunds           RefundRecord[]
  billingReminders  BillingReminder[]
  webhookEvents     WebhookEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, paidAt])
  @@index([tenantId, studentId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, gatewayOrderId])
  @@index([tenantId, gatewayPaymentId])
  @@index([receiptNumber])
}

model RefundRecord {
  id                   String       @id @default(uuid())
  tenantId             String
  paymentTransactionId String
  invoiceId            String?
  studentId            String
  refundNumber         String
  amount               Decimal      @db.Decimal(10, 2)
  currency             String       @default("INR")
  status               RefundStatus @default(COMPLETED)
  reason               String
  refundMode           PaymentMode
  utrReference         String?
  idempotencyKey       String?
  creditRestored       Boolean      @default(false)
  processedByUserId    String?
  creditNoteId         String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization    Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment         PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  invoice         TaxInvoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  student         Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  processedByUser User?              @relation("RefundsProcessedByUser", fields: [processedByUserId], references: [id], onDelete: SetNull)
  creditNote      CreditNote?        @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  @@unique([tenantId, refundNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, paymentTransactionId])
  @@index([tenantId, studentId])
}

model CreditNote {
  id               String           @id @default(uuid())
  tenantId         String
  invoiceId        String
  creditNoteNumber String
  reason           String
  amount           Decimal          @db.Decimal(10, 2)
  taxAmount        Decimal          @default(0.00) @db.Decimal(10, 2)
  totalAmount      Decimal          @db.Decimal(10, 2)
  status           CreditNoteStatus @default(ISSUED)
  issuedAt         DateTime         @default(now())
  issuedByUserId   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice      TaxInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  issuedByUser User?          @relation("CreditNotesIssuedByUser", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  refunds      RefundRecord[]

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId, invoiceId])
}

enum PaymentGatewayProvider {
  RAZORPAY
  STRIPE
}

enum ReconciliationStatus {
  NOT_APPLICABLE
  MATCHED
  UNMATCHED
  MANUALLY_RECONCILED
  DISCREPANCY
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum ReminderType {
  EXPIRY_APPROACHING
  MEMBERSHIP_EXPIRED
  INVOICE_OVERDUE
  PAYMENT_REMINDER
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum MembershipRenewalStatus {
  UPCOMING
  RENEWED
  LAPSED
  OPTED_OUT
