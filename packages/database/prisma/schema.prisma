model PaymentGatewayConfig {
  id              String                 @id @default(uuid())
  tenantId        String
  provider        PaymentGatewayProvider
  isEnabled       Boolean                @default(false)
  isTestMode      Boolean                @default(true)
  apiKey          String?
  apiSecret       String?
  webhookSecret   String?
  merchantAccount String?
  settings        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model WebhookEvent {
  id                   String                 @id @default(uuid())
  tenantId             String
  provider             PaymentGatewayProvider
  eventId              String
  eventType            String
  signature            String?
  payload              Json
  status               WebhookEventStatus     @default(RECEIVED)
  errorMessage         String?
  processedAt          DateTime?
  paymentTransactionId String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization       Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model BillingReminder {
  id                   String                     @id @default(uuid())
  tenantId             String
  studentId            String
  studentMembershipId  String?
  invoiceId            String?
  paymentTransactionId String?
  reminderType         ReminderType
  channel              NotificationChannel
  recipient            String
  templateName         String?
  subject              String?
  messageBody          String
  status               NotificationDeliveryStatus @default(PENDING)
  scheduledFor         DateTime                   @default(now())
  sentAt               DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  failureReason        String?
  metadata             Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  organization       Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentMembership  StudentMembership?  @relation(fields: [studentMembershipId], references: [id], onDelete: SetNull)
  invoice            TaxInvoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId, reminderType])
  @@index([tenantId, status, scheduledFor])
}

