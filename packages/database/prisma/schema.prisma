datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Initial baseline model for system connection verification
// Business-domain models will be added in Phase 2+ (P07+)
model SystemHealthCheck {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now())
  status    String   @default("OK")
}
