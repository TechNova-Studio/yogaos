model MediaAsset {
  id               String      @id @default(uuid())
  tenantId         String?
  uploadedByUserId String?
  title            String
  description      String?
  mediaType        MediaType
  mediaStatus      MediaStatus @default(READY)
  fileName         String
  fileSize         Int
  mimeType         String
  storageKey       String
  url              String
  thumbnailUrl     String?
  durationSeconds  Int?
  sha256Hash       String?
  metadata         Json?
  isArchived       Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  organization        Organization?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedByUser      User?          @relation("MediaUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  primaryAsanas       Asana[]        @relation("AsanaPrimaryMedia")
  asanaMediaItems     AsanaMedia[]
  stepVoiceAudios     SequenceStep[] @relation("StepVoiceAudio")
  stepDemoVideos      SequenceStep[] @relation("StepDemoVideo")
  stepReferenceImages SequenceStep[] @relation("StepReferenceImage")

  @@index([tenantId, mediaType, isArchived])
